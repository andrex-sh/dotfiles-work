// waybar - sway laptop (replaces the old i3status bar); hardware block uses
// Nerd Font icons; volume and power do too, everything else stays plain text
{
    "layer": "top",
    "position": "top",
    "modules-left": [
        "custom/power",
        "sway/workspaces"
    ],
    "modules-center": [
        "clock"
    ],
    "modules-right": [
        "sway/language",
        "custom/hardware",
        "battery",
        "pulseaudio",
        "custom/notification",
        "tray"
    ],
    "sway/language": {
        "format": "{short}",
        "on-click": "swaymsg input type:keyboard xkb_switch_layout next"
    },
    "custom/hardware": {
        "exec": "$HOME/.config/sway/hwstatus.sh",
        "return-type": "json",
        "interval": 3,
        "on-click": "foot --app-id=foot-btop -e btop"
    },
    "battery": {
        "states": {
            "warning": 30,
            "critical": 15
        },
        "format": "{icon} {capacity}%",
        "format-charging": " {capacity}%",  // nf-fa-bolt U+F0E7
        "format-icons": [
            "",  // nf-fa-battery_empty U+F244
            "",  // nf-fa-battery_quarter U+F243
            "",  // nf-fa-battery_half U+F242
            "",  // nf-fa-battery_three_quarters U+F241
            ""   // nf-fa-battery_full U+F240
        ],
        "tooltip-format": "{timeTo} ({power}W)"
    },
    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-muted": " {volume}%",  // nf-fa-volume_off U+F026
        "format-icons": {
            "default": [
                "",  // nf-fa-volume_down U+F027
                ""   // nf-fa-volume_up U+F028
            ]
        },
        "on-click": "swaync-client -t -sw",  // volume slider lives in swaync's panel
        "on-click-right": "$HOME/.config/sway/pavucontrol-toggle.sh"
    },
    "custom/notification": {
        "tooltip": true,
        "format": "<span size='16pt'>{icon}</span>",
        "format-icons": {
            "notification": "󱅫",
            "none": "󰂜",
            "dnd-notification": "󰂠",
            "dnd-none": "󰪓",
            "inhibited-notification": "󰂛",
            "inhibited-none": "󰪑"
        },
        "return-type": "json",
        "exec-if": "which swaync-client",
        "exec": "swaync-client -swb",
        "on-click": "swaync-client -t -sw",
        "on-click-right": "swaync-client -d -sw",
        "escape": true
    },
    "clock": {
        "format": "{:%a %Y-%m-%d %H:%M:%S}",
        "interval": 1,
        "tooltip": false,
        "on-click": "gsimplecal"
    },
    "tray": {
        "icon-size": 18,
        "spacing": 8
    },
    "custom/power": {
        "format": "",  // nf-fa-power_off U+F011
        "tooltip": false,
        "on-click": "$HOME/.config/sway/powermenu.sh"
    }
}
